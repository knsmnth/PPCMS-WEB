rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasEmail() {
      return isSignedIn() && request.auth.token.email is string;
    }

    function userEmail() {
      return request.auth.token.email.lower();
    }

    function isSelf(emailId) {
      return hasEmail() && emailId == userEmail();
    }

    function hasRole(role) {
      return hasEmail()
        && exists(/databases/$(database)/documents/users/$(userEmail()))
        && get(/databases/$(database)/documents/users/$(userEmail())).data.role == role;
    }

    function hasActiveRole() {
      return hasRole('admin') || hasRole('super_admin');
    }

    function isSuperAdmin() {
      return hasRole('super_admin');
    }

    function hasValidManagedUserFields(emailId) {
      return request.resource.data.keys().hasAll(['email', 'role'])
        && request.resource.data.keys().hasOnly([
          'email', 'role', 'uid', 'displayName', 'photoURL', 'createdAt', 'lastLogin'
        ])
        && request.resource.data.email == emailId
        && request.resource.data.role in ['admin', 'super_admin'];
    }

    function changesOnlyOwnProfileFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'uid', 'displayName', 'photoURL', 'lastLogin'
      ]);
    }

    function isOperationalCollection(collectionName) {
      return collectionName in [
        'campuses',
        'facilities',
        'projects',
        'schedulesOfWork',
        'scheduleSummaries',
        'summaryItems',
        'workGroupTemplates',
        'workGroupTemplateItems',
        'scheduleTemplates',
        'scheduleTemplateWorks',
        'scheduleTemplateWorkGroups',
        'signatures'
      ];
    }

    // Role records are keyed by lowercase email address. The first super-admin
    // must be seeded out-of-band as described in docs/SETUP.md.
    match /users/{emailId} {
      allow get: if isSelf(emailId) || isSuperAdmin();
      allow list: if isSuperAdmin();

      allow create: if isSuperAdmin() && hasValidManagedUserFields(emailId);

      allow update: if (
        isSuperAdmin()
        && !isSelf(emailId)
        && hasValidManagedUserFields(emailId)
      ) || (
        isSelf(emailId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.email == resource.data.email
        && changesOnlyOwnProfileFields()
      );

      // Prevent a super-admin from accidentally removing their own access.
      allow delete: if isSuperAdmin() && !isSelf(emailId);
    }

    // Public master-data endpoints used by external university systems.
    match /materials/{document=**} {
      allow read: if true;
      allow write: if hasActiveRole();
    }

    match /equipments/{document=**} {
      allow read: if true;
      allow write: if hasActiveRole();
    }

    match /laborTypes/{document=**} {
      allow read: if true;
      allow write: if hasActiveRole();
    }

    // Explicit allowlist prevents this rule from overlapping /users.
    match /{collectionName}/{document=**} {
      allow read, write: if isOperationalCollection(collectionName) && hasActiveRole();
    }
  }
}
