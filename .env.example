# Copy this file to .env.local and paste the Web app configuration from
# Firebase Console > Project settings > General > Your apps.
VITE_FIREBASE_API_KEY=replace-with-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=replace-with-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=replace-with-project-id
VITE_FIREBASE_STORAGE_BUCKET=replace-with-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-with-messaging-sender-id
VITE_FIREBASE_APP_ID=replace-with-web-app-id

# Optional. Leave blank when Google Analytics is not enabled for this project.
VITE_FIREBASE_MEASUREMENT_ID=
